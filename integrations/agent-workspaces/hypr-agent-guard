#!/usr/bin/env python3
"""Fallback for agent windows; primary placement belongs to config.silent."""
import json
import os
from pathlib import Path
import re
import socket
import sys
import time

KEY = re.compile(rb'OMP_GUI_KEY=([0-9a-f]{24})\Z')
ADDRESS = re.compile(r'0x[0-9a-fA-F]+\Z')
POLL = 0.1


def destination(pid):
    legacy = False
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return None
    for _ in range(64):
        if pid <= 1:
            break
        try:
            entries = Path(f'/proc/{pid}/environ').read_bytes().split(b'\0')
            for entry in entries:
                match = KEY.fullmatch(entry)
                if match:
                    return 'special:omp-' + match[1].decode('ascii')
                if entry.startswith((b'AGENT=', b'OMPCODE=')):
                    legacy = True
            status = Path(f'/proc/{pid}/status').read_text()
            match = re.search(r'^PPid:\s*(\d+)$', status, re.MULTILINE)
            if not match:
                break
            pid = int(match[1])
        except (OSError, ValueError):
            break
    return 'special:agent-tests' if legacy else None


def hypr(endpoint, request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(2)
        connection.connect(endpoint)
        connection.sendall(request.encode())
        chunks = []
        while True:
            chunk = connection.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
    return b''.join(chunks).decode(errors='replace')


def main():
    signature = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE')
    if not signature:
        sys.exit('hypr-agent-guard: missing target HYPRLAND_INSTANCE_SIGNATURE')
    runtime = os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
    endpoint = f'{runtime}/hypr/{signature}/.socket.sock'
    seen = set()
    while True:
        try:
            clients = json.loads(hypr(endpoint, 'j/clients'))
            present = {(c.get('address'), c.get('pid')) for c in clients}
            seen.intersection_update(present)
            for client in clients:
                address, pid = client.get('address'), client.get('pid')
                identity = (address, pid)
                if not isinstance(address, str) or not ADDRESS.fullmatch(address) or identity in seen:
                    continue
                workspace = (client.get('workspace') or {}).get('name') or ''
                if client.get('class') == 'pult-session' or workspace.startswith('special:omp-'):
                    seen.add(identity)
                    continue
                # Never pull an intentionally moved window out of another hidden workspace.
                if workspace.startswith('special:') and workspace != 'special:agent-tests':
                    seen.add(identity)
                    continue
                target = destination(pid)
                if not target:
                    continue
                if workspace == target:
                    seen.add(identity)
                    continue
                result = hypr(endpoint, 'dispatch hl.dsp.window.move({ window = "address:%s", '
                              'workspace = "%s", follow = false })' % (address, target))
                if result.strip() == 'ok':
                    seen.add(identity)
        except (OSError, ValueError, TypeError):
            pass
        time.sleep(POLL)


if __name__ == '__main__':
    main()
